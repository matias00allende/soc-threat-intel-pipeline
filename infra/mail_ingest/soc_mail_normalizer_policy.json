{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawMail",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::PLACEHOLDER_RAW_BUCKET_NAME",
        "arn:aws:s3:::PLACEHOLDER_RAW_BUCKET_NAME/*"
      ]
    },
    {
      "Sid": "ReadWriteNormalized",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::PLACEHOLDER_NORMALIZED_BUCKET_NAME",
        "arn:aws:s3:::PLACEHOLDER_NORMALIZED_BUCKET_NAME/*"
      ]
    }
  ]
}