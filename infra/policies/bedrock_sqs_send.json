{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCorporateMailQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:ListQueues"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UseCorporateMailSendQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:sqs:PLACEHOLDER_REGION:PLACEHOLDER_ACCOUNT_ID:PLACEHOLDER_SEND_QUEUE_NAME"
    }
  ]
}
