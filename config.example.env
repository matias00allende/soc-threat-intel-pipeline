# =============================================================================
# config.example.env - Configuracion parametrizable para nueva institucion
# =============================================================================
# Copia este archivo a config.env y completa TODOS los valores antes de
# ejecutar cualquier script de despliegue.
#
# REGLA: ningun valor debe quedar como PLACEHOLDER al momento de desplegar.
# Los valores con "(auto)" son detectados automaticamente y pueden omitirse.
# =============================================================================


# -----------------------------------------------------------------------------
# IDENTIDAD DE LA INSTITUCION
# -----------------------------------------------------------------------------

# Nombre completo de la institucion (aparece en correos y documentacion)
INSTITUTION_NAME="Municipalidad de Ejemplo"

# URL publica del sitio web (sin barra final)
INSTITUTION_WEBSITE_URL="https://www.ejemplo.cl"

# URL publica del logo (usada en template HTML de correos)
INSTITUTION_LOGO_URL="https://www.ejemplo.cl/assets/logo.png"

# Etiqueta SOC para tagging en MISP y sistemas de inteligencia de amenazas
# Formato recomendado: soc-[nombre-corto-institucion] (sin espacios, ASCII)
SOC_SOURCE_TAG="soc-nombreinstitucion"


# -----------------------------------------------------------------------------
# DOMINIOS Y DNS
# -----------------------------------------------------------------------------

# Dominio base de la institucion (debe estar en Route53 de la cuenta AWS)
INSTITUTION_BASE_DOMAIN="ejemplo.cl"

# Hostname completo donde se publicara n8n
N8N_HOSTNAME="n8n.ejemplo.cl"

# Subdominio para el servidor de correo (SES inbound)
MAILING_SUBDOMAIN_HOSTNAME="mailing.ejemplo.cl"

# Hostname para servir la blocklist SHA256 via CloudFront (opcional)
# Dejar vacio si no se usa CloudFront para la blocklist
BLOCKLIST_HOSTNAME="hashfw.ejemplo.cl"

# Hostname para el endpoint IOC publico (opcional, requiere dominio .ai u otro)
IOC_HOSTNAME="ioc.ejemplo.ai"


# -----------------------------------------------------------------------------
# AWS - CUENTA Y REGION
# -----------------------------------------------------------------------------

# Cuenta AWS destino del despliegue
# Se auto-detecta via "aws sts get-caller-identity" si se deja vacio
AWS_ACCOUNT_ID="123456789012"

# Region AWS de despliegue (todos los recursos se crean en esta region)
AWS_REGION="us-east-1"

# Perfil AWS CLI a usar (debe tener permisos de despliegue CloudFormation)
AWS_PROFILE="default"


# -----------------------------------------------------------------------------
# RED - VPC Y SUBNETS
# -----------------------------------------------------------------------------

# ID de la VPC existente donde se desplegaran los recursos
VPC_ID="vpc-XXXXXXXXXXXXXXXXXXX"

# Subnets publicas (para ALB) - separadas por coma, al menos 2 AZs distintas
PUBLIC_SUBNET_1="subnet-XXXXXXXXXXXXXXXXXXX"
PUBLIC_SUBNET_2="subnet-XXXXXXXXXXXXXXXXXXX"

# Subnets privadas (para ECS, RDS, Redis, Lambdas) - al menos 2 AZs distintas
PRIVATE_SUBNET_1="subnet-XXXXXXXXXXXXXXXXXXX"
PRIVATE_SUBNET_2="subnet-XXXXXXXXXXXXXXXXXXX"

# CIDR del rango de IPs autorizado a acceder a n8n (interfaz web)
# Formato: x.x.x.x/32 para IP fija, x.x.x.x/24 para rango
ADMIN_CIDR="203.0.113.1/32"

# IPs publicas /32 de los NAT Gateway de la VPC.
# El ALB y el WAF aceptan el webhook de SES solo desde estas IPs.
# Obtener con:
#   aws ec2 describe-nat-gateways \
#     --filter "Name=vpc-id,Values=$VPC_ID" \
#     --query 'NatGateways[*].NatGatewayAddresses[0].PublicIp' \
#     --output text --profile $AWS_PROFILE
# Si solo hay un NAT Gateway, repetir el mismo valor en NAT_CIDR_B.
NAT_CIDR_A="198.51.100.10/32"
NAT_CIDR_B="198.51.100.11/32"


# -----------------------------------------------------------------------------
# DNS Y CERTIFICADOS TLS (ACM)
# -----------------------------------------------------------------------------

# Hosted Zone ID en Route53 para INSTITUTION_BASE_DOMAIN
N8N_HOSTED_ZONE_ID="ZXXXXXXXXXXXXXXXXXXXX"

# ARN del certificado ACM para N8N_HOSTNAME (debe cubrir el dominio o wildcard)
# Ejemplo: arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
N8N_ACM_CERT_ARN="arn:aws:acm:REGION:ACCOUNT_ID:certificate/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"

# ARN del certificado ACM para BLOCKLIST_HOSTNAME (opcional, requiere us-east-1 para CloudFront)
BLOCKLIST_ACM_CERT_ARN="arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"

# Hosted Zone ID en Route53 para el dominio del IOC_HOSTNAME (puede ser distinto al base)
IOC_HOSTED_ZONE_ID="ZXXXXXXXXXXXXXXXXXXXX"

# ARN del certificado ACM para IOC_HOSTNAME (requiere us-east-1 para CloudFront)
IOC_ACM_CERT_ARN="arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"


# -----------------------------------------------------------------------------
# CORREO - INGESTA Y NOTIFICACIONES
# -----------------------------------------------------------------------------

# Direccion de correo donde llegan los boletines del proveedor externo
# Este correo debe existir como regla en SES Receipt Rules de MAILING_SUBDOMAIN_HOSTNAME
INGEST_EMAIL_ADDRESS="soc-ingest@mailing.ejemplo.cl"

# Dominios remitentes autorizados para depositar boletines (separados por coma)
# Incluir el dominio propio + dominios de proveedores de inteligencia de amenazas
ALLOWED_SENDER_DOMAINS="ejemplo.cl,proveedor-ciberseguridad.com"

# Direccion de correo desde la que el SOC Bot envia notificaciones
# Debe estar verificada como identidad en SES
SOC_EMAIL_FROM="soc-bot@mailing.ejemplo.cl"

# Destinatario principal de las alertas IOC (equipo de infraestructura / SOC)
SOC_EMAIL_TO="equipo-soc@ejemplo.cl"

# Destinatarios en copia (CC) de las alertas IOC (separados por coma)
SOC_EMAIL_CC="ciso@ejemplo.cl"


# -----------------------------------------------------------------------------
# S3 - BUCKETS DE ALMACENAMIENTO
# -----------------------------------------------------------------------------
# IMPORTANTE: Los nombres de buckets S3 son globalmente unicos en AWS.
# Convencion recomendada: [prefijo]-[cuenta]-[region] para evitar colisiones.

# Bucket para correos crudos recibidos por SES (emails en formato RFC 5322)
S3_BUCKET_RAW="soc-mail-raw-123456789012-us-east-1"

# Bucket para correos normalizados (JSON estructurado, listo para n8n)
S3_BUCKET_NORMALIZED="soc-mail-normalized-123456789012-us-east-1"

# Bucket para la blocklist IOC (hash_sha256.txt) y CloudFront origin
S3_BUCKET_IOC="soc-ioc-blocklist-123456789012-us-east-1"

# Bucket existente para access logs del ALB (debe tener la policy S3 de delivery de ELB)
# Ver: https://docs.aws.amazon.com/elasticloadbalancing/latest/application/enable-access-logging.html
S3_BUCKET_ACCESS_LOGS="mi-bucket-de-logs-alb"


# -----------------------------------------------------------------------------
# SQS - COLA DE ENVIO DE CORREO
# -----------------------------------------------------------------------------

# URL de la cola SQS donde n8n publica los mensajes de notificacion
# Si usa modo monolito (all_in_one_stack), esta cola se crea automaticamente.
# Si usa modo desacoplado, obtener la URL del stack stack-mailing-plataformas.
SQS_SEND_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/nombre-de-la-cola"

# ARN de la misma cola (usado en politicas IAM)
SQS_SEND_QUEUE_ARN="arn:aws:sqs:us-east-1:123456789012:nombre-de-la-cola"


# -----------------------------------------------------------------------------
# N8N - CONFIGURACION DE LA PLATAFORMA
# -----------------------------------------------------------------------------

# Licencia n8n (requerida para queue mode con main + worker separados)
# Obtener en: https://app.n8n.io/
# Dejar vacio para usar n8n Community Edition (sin queue mode, un solo proceso)
N8N_LICENSE_KEY=""

# Imagen Docker de n8n a desplegar
# Default: imagen oficial de DockerHub (no requiere ECR propio)
N8N_IMAGE_URI="n8nio/n8n:latest"

# URL base del webhook n8n (sin barra final)
# Se construye automaticamente como https://N8N_HOSTNAME/webhook/soc
# Solo cambiar si se usa un path personalizado
N8N_WEBHOOK_BASE_URL="https://n8n.ejemplo.cl/webhook/soc"

# Capacidad de las tasks ECS (CPU en unidades vCPU*1024, memoria en MiB)
N8N_TASK_CPU="512"
N8N_TASK_MEMORY="2048"

# Clase de instancia RDS PostgreSQL
RDS_INSTANCE_CLASS="db.t4g.medium"
RDS_ALLOCATED_STORAGE="50"
RDS_MAX_ALLOCATED_STORAGE="100"

# Clase de instancia ElastiCache Redis
REDIS_INSTANCE_CLASS="cache.t4g.medium"


# -----------------------------------------------------------------------------
# SECRETS MANAGER - NOMBRES DE SECRETOS
# -----------------------------------------------------------------------------
# Los stacks CFN (all_in_one_stack y n8n_stack_template) crean los secretos con
# el prefijo del nombre del stack. Es decir: si despliegas con StackName=soc-n8n
# el secreto sera "soc-n8n/dbcredentials".
# Para mantener una sola fuente de verdad, define aqui el StackName y usalo en
# todos los SECRET_NAME_*.

# Nombre del stack CloudFormation que se desplegara (sin espacios, ASCII)
STACK_NAME="soc-n8n"

# Los siguientes secretos los crea el stack automaticamente. Si quieres
# referenciarlos desde scripts o desde otros stacks, usa estos paths.
SECRET_NAME_DB="${STACK_NAME}/dbcredentials"
SECRET_NAME_REDIS="${STACK_NAME}/redispassword"
SECRET_NAME_N8N="${STACK_NAME}/encryptionkey"
SECRET_NAME_LICENSE="${STACK_NAME}/n8nlicense"

# Secreto de la API de Bitdefender GravityZone (opcional).
# Este secreto NO lo crea el stack: hay que crearlo manualmente antes de activar
# la integracion. Debe contener un JSON con dos campos exactos:
#   {"apiKey":"<API_KEY>","companyId":"<COMPANY_ID>"}
# El stack lee estos campos como secretos individuales y los inyecta como
# SOC_BITDEFENDER_API_KEY y SOC_BITDEFENDER_COMPANY_ID en las tasks ECS de n8n.
# Convencion recomendada: ${STACK_NAME}/bitdefendergravityzone.
SECRET_NAME_BITDEFENDER="${STACK_NAME}/bitdefendergravityzone"

# Secreto de MISP (opcional, si se usa integracion MISP)
SECRET_NAME_MISP="${STACK_NAME}/misp"


# -----------------------------------------------------------------------------
# CLOUDFRONT - DISTRIBUCION PARA BLOCKLIST (OPCIONAL)
# -----------------------------------------------------------------------------
# Solo necesario si se quiere servir la blocklist publicamente via HTTPS.
# Si no se usa CloudFront, dejar en blanco - el workflow leeran el bucket S3 directamente.

# ID de la distribucion CloudFront para la blocklist (obtenido tras crear el stack)
# Se autocompleta si se usa all_in_one_stack o n8n_stack_template con el parametro habilitado.
CLOUDFRONT_BLOCKLIST_DIST_ID=""

# ID de la distribucion CloudFront para el endpoint IOC (opcional)
CLOUDFRONT_IOC_DIST_ID=""


# -----------------------------------------------------------------------------
# WAF - CONFIGURACION
# -----------------------------------------------------------------------------

# Limite de requests por 5 minutos por IP (rate limiting WAF)
WAF_RATE_LIMIT="2000"

# Retencion de logs WAF en CloudWatch (dias)
WAF_LOG_RETENTION_DAYS="30"


# -----------------------------------------------------------------------------
# INTEGRACIONES OPCIONALES
# -----------------------------------------------------------------------------

# URL del servidor MISP local (si se usa integracion MISP)
MISP_URL="https://misp.ejemplo.cl"

# URLs de la API JSON-RPC de Bitdefender GravityZone.
# Los workflows bitdefender_*.template.json invocan ambos endpoints:
#  - Incidents v1.2: usado para listar y agregar items en la blocklist
#  - Licensing v1.0: usado para validar la licencia antes de la reconciliacion
# Estos valores son los defaults oficiales de Bitdefender Cloud y normalmente
# no requieren cambios. Cambiarlos solo si Bitdefender lo indica explicitamente
# (por ejemplo, en datacenter regional distinto).
# Se inyectan al stack via los parametros BitdefenderIncidentsV12Url y
# BitdefenderLicensingV10Url, y a las tasks ECS como SOC_BITDEFENDER_*_URL.
BITDEFENDER_INCIDENTS_V12_URL="https://cloud.gravityzone.bitdefender.com/api/v1.2/jsonrpc/incidents"
BITDEFENDER_LICENSING_V10_URL="https://cloud.gravityzone.bitdefender.com/api/v1.0/jsonrpc/licensing"
